// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model User {
  id        String   @id @default(uuid())
  name      String
  email     String   @unique
  password  String
  role      String   @default("ADMIN")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Category {
  id        String   @id @default(uuid())
  name      String
  type      String   // 'IN' (Receita) ou 'OUT' (Despesa)
  color     String?  // Cor para o gráfico
  context   String   @default("PJ") // 'PJ' ou 'PF'
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  transactions Transaction[]
  budgets      Budget[]
}

model Entity {
  id        String   @id @default(uuid())
  name      String
  document  String?  // CPF/CNPJ
  type      String   // 'SUPPLIER' (Fornecedor) ou 'CLIENT' (Cliente)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  transactions Transaction[]
}

model Company {
  id        String   @id @default(uuid())
  name      String
  document  String?  // CNPJ
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  transactions Transaction[]
}

model BankAccount {
  id        String   @id @default(uuid())
  name      String   // ex: Itaú, Nubank, Caixa
  agency    String?
  account   String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  transactions Transaction[]
}

model Transaction {
  id          String    @id @default(uuid())
  description String
  amount      Float
  type        String    // 'IN' ou 'OUT'
  status      String    // 'PENDING', 'PAID', 'OVERDUE'
  dueDate     DateTime
  paymentDate DateTime?
  isRecurring Boolean   @default(false)
  attachmentUrl String?
  context     String    @default("PJ") // 'PJ' (Empresa) ou 'PF' (Pessoal)
  
  // Relacionamentos
  categoryId  String?
  category    Category? @relation(fields: [categoryId], references: [id])
  
  entityId    String?
  entity      Entity?   @relation(fields: [entityId], references: [id])

  companyId   String?
  company     Company?  @relation(fields: [companyId], references: [id])

  bankAccountId String?
  bankAccount   BankAccount? @relation(fields: [bankAccountId], references: [id])

  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([dueDate])
  @@index([status])
  @@index([type])
  @@index([context])
  @@index([companyId])
}

model Budget {
  id         String   @id @default(uuid())
  categoryId String?
  category   Category? @relation(fields: [categoryId], references: [id])
  name       String   // Nome livre se não tiver categoria
  limitAmount Float
  month      Int      // 1-12
  year       Int
  context    String   @default("PF")
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([month, year, context])
}

model Goal {
  id            String   @id @default(uuid())
  name          String
  emoji         String   @default("🎯")
  targetAmount  Float
  currentAmount Float    @default(0)
  deadline      DateTime?
  context       String   @default("PF")
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}
