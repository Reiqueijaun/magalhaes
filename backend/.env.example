# ─── BANCO DE DADOS ──────────────────────────────────────────────────────────
# Substitua pela sua URL do banco PostgreSQL
DATABASE_URL="postgresql://USER:PASSWORD@HOST/DATABASE?sslmode=require"

# ─── SERVIDOR ─────────────────────────────────────────────────────────────────
PORT=3001
NODE_ENV=production

# ─── SEGURANÇA (OBRIGATÓRIO em produção) ─────────────────────────────────────
# Gere com: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
# Mínimo: 32 caracteres aleatórios
JWT_SECRET=GERE_UMA_CHAVE_ALEATORIA_DE_64_CHARS_AQUI

# PIN numérico para recuperação de senha (ex: 4-8 dígitos)
SECURITY_PIN=DEFINA_UM_PIN_SEGURO

# Token para autenticar chamadas ao /api/health (monitoramento)
HEALTH_TOKEN=GERE_UM_TOKEN_ALEATORIO_AQUI

# Token para o backup automático via GET /api/admin/backup/auto
# (cabeçalho: x-backup-token). Mínimo 16 caracteres. Se não definido, só o
# download manual pelo painel de administração fica disponível.
BACKUP_TOKEN=GERE_UM_TOKEN_ALEATORIO_AQUI

# ─── CORS (opcional) ──────────────────────────────────────────────────────────
# Lista de origens permitidas separadas por vírgula (se não definido, usa defaults)
# ALLOWED_ORIGINS=https://magalhaes.online,https://www.magalhaes.online
